# Used by docker-compose.prod.yml to configure all three services together.
# Copy to .env.prod (gitignored) and fill in real values before deploying.

POSTGRES_USER=cashdelivery
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=cashdelivery

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-value
CLIENT_ORIGIN=https://your-frontend-domain.example
REQUEST_ACCEPT_WINDOW_SECONDS=600
NODE_ENV=production
# Leave false in real deployments (see server/.env.example for details)
ENABLE_DEV_OTP=false

# Resend — used to deliver OTP codes by email over HTTPS (not SMTP, which
# is blocked outbound on many hosts). Leave blank and no OTP email will be
# sent (registration/login still work, but users get no code).
RESEND_API_KEY=
RESEND_FROM="Mobiler <onboarding@resend.dev>"

# Google OAuth Client ID — same value on both sides (server verifies the
# `aud` claim, client uses it to render the "Continue with Google" button).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Baked into the client bundle at build time (see client/Dockerfile).
VITE_API_URL=https://your-api-domain.example/api
VITE_SOCKET_URL=https://your-api-domain.example

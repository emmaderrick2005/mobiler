DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-value"
PORT=4000
CLIENT_ORIGIN="https://your-frontend-domain.example"
REQUEST_ACCEPT_WINDOW_SECONDS=600
NODE_ENV=production

# Leave ENABLE_DEV_OTP unset/false in any environment reachable by real
# users — when true, verification codes are echoed back in API responses
# and logged in full, instead of only being sent by email.
ENABLE_DEV_OTP=false

# Resend (https://resend.com) — used to send OTP codes by email via HTTPS
# API (see src/utils/email.js), not raw SMTP, since several hosts block
# outbound SMTP ports. Without this set, OTP codes are not delivered
# anywhere, so registration/login will appear to work but no code will
# reach the user unless ENABLE_DEV_OTP is also on.
RESEND_API_KEY=
# Until a custom domain is verified in Resend, sending only works to the
# email address the Resend account itself was created with.
RESEND_FROM="Mobiler <onboarding@resend.dev>"

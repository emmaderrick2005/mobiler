DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-value"
PORT=4000
CLIENT_ORIGIN="https://your-frontend-domain.example"
REQUEST_ACCEPT_WINDOW_SECONDS=600
NODE_ENV=production

# Leave ENABLE_DEV_OTP unset/false in any environment reachable by real
# users — when true, verification codes are echoed back in API responses
# and logged in full, instead of only being sent by email.
ENABLE_DEV_OTP=false

# SMTP — used to send OTP codes by email (see src/utils/email.js). Works
# with any SMTP provider (Gmail app password, Resend, SendGrid, Mailgun,
# etc.). Without these set, OTP codes are not delivered anywhere, so
# registration/login will appear to work but no code will reach the user
# unless ENABLE_DEV_OTP is also on.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset.
SMTP_FROM=

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-value"
PORT=4000
CLIENT_ORIGIN="https://your-frontend-domain.example"
REQUEST_ACCEPT_WINDOW_SECONDS=600
NODE_ENV=production

# Leave ENABLE_DEV_OTP unset/false in any environment reachable by real
# users — when true, verification codes are echoed back in API responses
# and logged in full, instead of only being sent by SMS.
ENABLE_DEV_OTP=false

# Africa's Talking (https://africastalking.com) — used to send OTP SMS.
# Without these set, OTP codes are not delivered anywhere (see
# src/utils/sms.js), so registration/login will appear to work but no code
# will reach the user unless ENABLE_DEV_OTP is also on.
AT_USERNAME=
AT_API_KEY=
# Country code prepended to local-format numbers like "0700000001".
SMS_DEFAULT_COUNTRY_CODE=256

VITE_API_URL=https://your-api-domain.example/api
VITE_SOCKET_URL=https://your-api-domain.example

# Google OAuth Client ID (from Google Cloud Console). Must match
# server/.env's GOOGLE_CLIENT_ID. Leave blank to hide the "Continue with
# Google" button entirely rather than show a broken one.
VITE_GOOGLE_CLIENT_ID=
